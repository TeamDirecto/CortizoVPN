[Unit]
Description=CortizoVPN Flask application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/CortizoVPN
Environment="PATH=/root/CortizoVPN/.venv/bin"
EnvironmentFile=-/root/CortizoVPN/.env
ExecStart=/root/CortizoVPN/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app.main:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

  # dialer -> DB MASTER/SLAVE
  target_user: kristian.maya
  port: 19600
  connect_timeout: 8

dialers:
  dial1:
    lan_ip: 10.10.15.10
    wan_ip: 201.132.81.26
    enabled: false
    note: "Temporalmente fuera por iptables; dejar preparado para habilitarlo sin cambiar código."
  dial2:
    lan_ip: 10.10.15.11
    wan_ip: 201.132.81.27
    enabled: true
  dial3:
    lan_ip: 10.10.15.12
    wan_ip: 201.132.81.28
    enabled: true
  dial4:
    lan_ip: 10.10.15.13
    wan_ip: 201.132.81.29
    enabled: true

database:
  slave:
    host: 10.10.15.14
    port: 19600
    jump_host: dial2
  master:
    host: 10.10.15.15
    port: 19600
    jump_host: dial2

extensions:
  # Rango global reservado para Cortizo.
  start: 161001
  end: 162800
  primary_node: dial1
  node_suffixes:
    dial1: ""
    dial2: "b"
    dial3: "c"
    dial4: "d"
